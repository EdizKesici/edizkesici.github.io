---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import figtreeUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, routes, SITE } from '../i18n/ui.js';

interface Props {
  lang: 'fr' | 'en';
  page: 'home' | 'parcours' | 'privacy' | 'notfound';
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const other = lang === 'fr' ? 'en' : 'fr';
const hasAlt = page !== 'notfound';
const path = hasAlt ? routes[page][lang] : '/404/';
const canonical = new URL(path, SITE.url).href;
const altUrl = hasAlt ? (l: 'fr' | 'en') => new URL(routes[page][l], SITE.url).href : null;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f241d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altUrl && <link rel="alternate" hreflang="fr-BE" href={altUrl('fr')} />}
    {altUrl && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {altUrl && <link rel="alternate" hreflang="x-default" href={altUrl('fr')} />}
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={figtreeUrl} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:site_name" content="Ediz Kesici" />
    <meta property="og:image" content={new URL(t.ogImage, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(t.ogImage, SITE.url).href} />
    {page === 'notfound' && <meta name="robots" content="noindex" />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#top">{t.skip}</a>

    <div class="sky" aria-hidden="true"></div>

    <Header lang={lang} page={page} />
    <slot />
    <Footer lang={lang} />

    <noscript><p class="ns">{t.contact.noscript} <a href={SITE.linkedin} rel="noopener noreferrer">LinkedIn</a></p></noscript>
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
