---
import { ui, routes } from '../i18n/ui.js';
interface Props { lang: 'fr' | 'en'; page: 'home' | 'parcours' | 'privacy' | 'notfound' }
const { lang, page } = Astro.props;
const t = ui[lang];
const home = routes.home[lang];
const other = lang === 'fr' ? 'en' : 'fr';
const hasAlt = page !== 'notfound';
const switchHref = hasAlt ? routes[page][other] : routes.home[other];
---

<header class="bar glass">
  <a class="mark" href={home} aria-label={`Ediz Kesici, ${lang === 'fr' ? 'accueil' : 'home'}`}>Ediz Kesici</a>
  <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
    <a href={`${home}#services`}>{t.nav.services}</a>
    <a href={`${home}#projets`}>{t.nav.projects}</a>
    <a href={routes.parcours[lang]} aria-current={page === 'parcours' ? 'page' : undefined}>{t.nav.path}</a>
    <a href={`${home}#contact`}>{t.nav.contact}</a>
  </nav>
  <div class="bar-end">
    <span class="lang" role="group" aria-label={t.langLabel}>
      {lang === 'fr' ? <span class="cur" lang="fr" aria-current="true">FR</span> : <a href={switchHref} lang="fr" hreflang="fr-BE">FR</a>}
      {lang === 'en' ? <span class="cur" lang="en" aria-current="true">EN</span> : <a href={switchHref} lang="en" hreflang="en">EN</a>}
    </span>
    <a class="btn btn-sm" data-mail href={`${home}#contact`}>{t.contactBtn}</a>
  </div>
</header>
